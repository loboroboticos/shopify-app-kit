# .env.example (shopify-app-kit template)
# Placeholders only; never a value. Copy to .env and fill it in. Each variable says whether it is PUBLIC (safe in
# a client bundle or a log), a SECRET (rotate it if it ever lands in git; .gitleaks.toml allowlists this file
# by name because it carries no values), or a LOCAL marker (means nothing outside this machine).
# Manifest keys this reflects: database.provider, database.rls, auth.expiringOfflineTokens, billing.testFlag.

# --- Shopify ------------------------------------------------------------------------------------------------

# PUBLIC. The app's client id. It feeds App Bridge in the browser and token exchange on the server, so it is
# visible to every merchant who installs the app; treat it as an identifier, not a credential.
SHOPIFY_API_KEY=<client-id>

# SECRET. The client secret: signs session tokens and verifies webhook HMACs. Never in a client bundle.
SHOPIFY_API_SECRET=<client-secret>

# PUBLIC. The URL Shopify redirects to; `shopify app dev` rewrites the dev registration's URLs to its tunnel.
SHOPIFY_APP_URL=https://example-app.example.com

# PUBLIC. Comma-separated access scopes; must equal the [access_scopes] of the app toml (tripwired).
SCOPES=read_products

# --- Database -----------------------------------------------------------------------------------------------

# SECRET. Runtime connection, as the app's own runtime role (no BYPASSRLS, not the owner). On a transaction
# pooler append `?pgbouncer=true`. Points at localhost here so a copied .env never reaches a shared database.
DATABASE_URL=postgresql://<runtime-role>:<password>@localhost:5432/example_app

# SECRET. Owner-role connection used by migrations only (`prisma migrate`); the app process never reads it.
# Present only for an RLS app (database.rls: true), where roles, grants and policies live in the migrations.
DIRECT_DATABASE_URL=postgresql://<owner-role>:<password>@localhost:5432/example_app

# LOCAL. A fingerprint of the database the dev command is allowed to migrate: sha256 of "<host>/<database>"
# from DATABASE_URL. The dev command computes the same value and refuses to run `prisma migrate dev` when
# they differ or this is empty, so a .env copied from another machine, or a DATABASE_URL edited to a shared
# database, fails loudly instead of migrating the wrong place.
DEV_DATABASE_FINGERPRINT=<sha256-of-host-slash-database>

# --- Billing ------------------------------------------------------------------------------------------------

# LOCAL. Billing test flag (billing.testFlag). On everywhere but production; production leaves it unset and the
# billing module fails closed to test mode when it cannot read a value.
BILLING_TEST=true

# --- Operator MCP connector (only when the app ships one) ---------------------------------------------------

# PUBLIC. Comma-separated hostnames allowed as OAuth redirect targets besides loopback. Unset warns at startup.
MCP_ALLOWED_REDIRECT_HOSTS=

# --- Local markers ------------------------------------------------------------------------------------------

# LOCAL. Selects development behaviour (verbose logs, the sandbox tunnel port). Never set in production.
NODE_ENV=development
