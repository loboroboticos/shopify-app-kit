{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loboroboticos/shopify-app-kit/schemas/shopify-app.v1.schema.json",
  "title": "shopify-app-kit manifest (schema v1)",
  "description": "Per-repo facts a Shopify app repo declares in .claude/shopify-app.json so the kit's guard hooks, doctor and skills can act on them. The top level is closed; sections may grow additively.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kit", "app", "shopifyCli", "branches", "packageManagers"],
  "properties": {
    "$schema": {
      "description": "Optional editor hint: a URL to this schema (for example the raw file at a kit tag). Ignored by the hooks.",
      "type": "string"
    },
    "$comment": {
      "description": "Optional free-text note for humans reading the manifest. Ignored by the hooks.",
      "type": "string"
    },
    "kit": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": {
          "description": "The kit version whose hooks were last vendored into this repo by /shopify-app-kit:sync; null before the first sync.",
          "type": ["string", "null"]
        }
      }
    },
    "app": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["embedded-app", "standalone-app", "theme-app-extension", "custom-app"] },
        "handles": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "shopifyCli": {
      "type": "object",
      "required": ["devPolicy", "deployPolicy", "configUsePolicy", "themeDevFromRoot"],
      "properties": {
        "configs": {
          "description": "Shopify CLI config names (the X in shopify.app.X.toml) the guard requires on app dev / app deploy.",
          "type": "object",
          "properties": {
            "dev": { "type": "string", "minLength": 1 },
            "deploy": { "type": "string", "minLength": 1 }
          }
        },
        "requireConfigFlag": { "type": "boolean" },
        "devPolicy": { "$ref": "#/$defs/policy" },
        "deployPolicy": { "$ref": "#/$defs/policy" },
        "configUsePolicy": { "$ref": "#/$defs/policy" },
        "themeDevFromRoot": { "type": "string", "enum": ["block", "allow"] }
      },
      "allOf": [
        {
          "if": { "properties": { "devPolicy": { "const": "config-required" } }, "required": ["devPolicy"] },
          "then": { "required": ["configs"], "properties": { "configs": { "required": ["dev"] } } }
        },
        {
          "if": { "properties": { "deployPolicy": { "const": "config-required" } }, "required": ["deployPolicy"] },
          "then": { "required": ["configs"], "properties": { "configs": { "required": ["deploy"] } } }
        }
      ]
    },
    "branches": {
      "type": "object",
      "required": ["default", "protected"],
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "protected": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "promotion": {
          "type": ["object", "null"],
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "packageManagers": {
      "description": "Repo-relative directory (\".\" for the root) to the package manager used there.",
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["npm", "pnpm"] }
    },
    "paths": {
      "type": "object",
      "properties": {
        "server": { "type": "string" },
        "shopifyServer": { "type": "string" },
        "appTomls": { "type": "array", "items": { "type": "string" } },
        "webhookHandlers": { "type": "string" },
        "prisma": { "type": "string" },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "storeBindings": { "type": "string" }
      }
    },
    "apiVersion": {
      "type": "object",
      "required": ["expected"],
      "properties": {
        "expected": { "type": "string", "pattern": "^20\\d\\d-(01|04|07|10)$" },
        "pins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "webhooks": {
      "type": "object",
      "properties": {
        "topics": { "type": "array", "items": { "type": "string" } },
        "compliance": { "type": "boolean" }
      }
    },
    "scopes": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deploy": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fly": { "type": "string" },
              "flyToml": { "type": "string" },
              "workflow": { "type": "string" }
            }
          }
        },
        "protectedWorkflows": { "type": "array", "items": { "type": "string" } },
        "scaleToZeroBeforeMigrate": { "type": "boolean" }
      }
    },
    "auth": {
      "description": "How the app authenticates with Shopify beyond the defaults of the app library.",
      "type": "object",
      "properties": {
        "expiringOfflineTokens": {
          "description": "True when the app runs future.expiringOfflineAccessTokens in its Shopify server module and its session table carries refreshToken and refreshTokenExpires. Shopify requires expiring offline access tokens for public apps created on or after 2026-04-01 and for all public apps from 2027-01-01 (60-minute access token, 90-day refresh token; obtaining a new token invalidates the previous refresh token, so one live refreshable token per app per store).",
          "type": "boolean"
        }
      }
    },
    "billing": {
      "type": "object",
      "properties": {
        "live": { "type": "boolean" },
        "testFlag": { "type": "string" },
        "method": {
          "description": "How merchants are charged. app-pricing: Shopify App Pricing (the successor of Managed Pricing), the default for public apps and available to public apps only; subscription webhooks are not delivered and status comes from the Partner Active Subscription API. billing-api: the Billing API, labelled legacy but functional and the only path for custom-distribution apps. none: the app does not charge.",
          "type": "string",
          "enum": ["billing-api", "app-pricing", "none"]
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "rls": { "type": "boolean" },
        "sharedDevDbWithBeta": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "fileSize": { "type": "string" },
        "tripwireDir": { "type": "string" }
      }
    },
    "docs": {
      "description": "Where the repo keeps its decision records and its docs map, so the docs-owner skill and the docs-consistency test know where to look.",
      "type": "object",
      "properties": {
        "adrDir": {
          "description": "Repo-relative directory of the architecture decision records, one file per decision (for example docs/adr).",
          "type": "string"
        },
        "mapFile": {
          "description": "Repo-relative file that carries the docs map, the table naming one owning document per fact family (for example README.md).",
          "type": "string"
        },
        "mapHeading": {
          "description": "The markdown heading under which mapFile carries the docs map (for example \"## Docs map\").",
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "string",
      "enum": ["config-required", "operator-only", "allowed"]
    }
  }
}
